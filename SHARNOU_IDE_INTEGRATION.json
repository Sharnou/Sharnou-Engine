{
  "schema": "sharnou-engine-project/2",
  "engine_id": "SharnouEngine",
  "engine_name": "Sharnou Engine",
  "canonical_game": {
    "project_id": "honour-war",
    "repository": "https://github.com/Sharnou/Honour-War"
  },
  "canonical_ide": {
    "id": "Sharnou-IDE",
    "repository": "https://github.com/Sharnou/Sharnou-IDE",
    "authority": "exclusive"
  },
  "project_protocol": "Sharnou Project Protocol (SPP)",
  "ide_migration": {
    "automatic_conversion": true,
    "target": "Sharnou-IDE SPP",
    "legacy_ide_runtime_control": "rejected"
  },
  "external_tool_policy": {
    "network_downloads": false,
    "external_tool_bootstrap": false,
    "rejected": ["Visual Studio", "MSBuild", "Windows SDK", "CMake", "vcpkg", "Unity", "Unreal Engine"]
  },
  "asset_format_policy": {
    "scene_containers": [".gltf", ".glb"],
    "scene_container_standard": "glTF 2.x",
    "three_d_texture_container": ".ktx2",
    "three_d_texture_standard": "KTX 2.0",
    "three_d_texture_glTF_extension": "KHR_texture_basisu",
    "two_d_visual_format": ".avif",
    "two_d_visual_uses": ["UI", "2D art", "menu backgrounds", "skyboxes", "distribution images"],
    "source_model_intake": [".fbx", ".obj"],
    "shipped_source_models": false,
    "rejected_texture_formats": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".dds", ".tga"],
    "rejected_runtime_model_formats": [".fbx", ".obj", ".blend"]
  },
  "runtime": {
    "control": "Sharnou-IDE",
    "commands": ["--self-test", "--runtime-test=300"]
  }
}
